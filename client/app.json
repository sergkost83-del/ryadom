{
  "expo": {
    "name": "РЯДОМ",
    "slug": "ryadom",
    "scheme": "ryadom",
    "version": "0.8.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/brand/app-icon-1024.png",
    "backgroundColor": "#FFFAF7",
    "ios": { "supportsTablet": false, "bundleIdentifier": "ru.ryadom.app" },
    "android": {
      "package": "ru.ryadom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "backgroundColor": "#FF5B45"
      }
    },
    "web": { "bundler": "metro", "output": "single", "favicon": "./assets/brand/favicon.png" },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-splash-screen", { "image": "./assets/brand/splash-icon.png", "backgroundColor": "#FFFAF7", "imageWidth": 220 }]
    ]
  }
}
