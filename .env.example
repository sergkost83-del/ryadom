# Скопируйте этот файл в .env. Файл .env в репозиторий НЕ попадает.
# Значения ниже — только для локальной разработки.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=insecure-dev-key-change-me
POSTGRES_DB=ryadom
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=ryadom_dev_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Почта (вход по коду). В разработке письма печатаются в консоль.
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=РЯДОМ <no-reply@localhost>
# Сколько прокси стоит перед сервером (в проде за Caddy/nginx — 1)
TRUSTED_PROXY_COUNT=0
