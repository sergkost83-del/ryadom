# Скопируйте этот файл в .env. Файл .env в репозиторий НЕ попадает.
# Значения ниже — только для локальной разработки.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=insecure-dev-key-change-me
POSTGRES_DB=ryadom
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=ryadom_dev_only
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
