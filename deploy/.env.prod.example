# Скопируйте в .env.prod и заполните. Файл .env.prod НИКОГДА не попадает в Git.
# Секреты генерируйте, как описано в RUNBOOK.md (раздел «Ключи»).

# --- Адрес ---
DOMAIN=example.ru
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=example.ru
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.ru
TRUSTED_PROXY_COUNT=1
# Секретный адрес админки: придумайте непредсказуемый, с косой чертой в конце
ADMIN_URL=panel-CHANGE_ME/

# --- Секреты ---
DJANGO_SECRET_KEY=CHANGE_ME_long_random_string_at_least_50_characters_xxxxxxxxxxxxxxxx
FIELD_ENCRYPTION_KEYS=CHANGE_ME_fernet_key

# --- База данных ---
POSTGRES_DB=ryadom
POSTGRES_USER=ryadom
POSTGRES_PASSWORD=CHANGE_ME

# --- Почта (вход по коду) ---
EMAIL_HOST=smtp.example.ru
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@example.ru
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=РЯДОМ <no-reply@example.ru>

# --- Резервные копии (шифруются публичным ключом age; приватный ключ хранится только у вас) ---
AGE_RECIPIENT=age1CHANGE_ME
BACKUP_REMOTE=backup:bucket-name/ryadom
RETENTION_DAYS=30
RCLONE_CONFIG_BACKUP_TYPE=s3
RCLONE_CONFIG_BACKUP_PROVIDER=Other
RCLONE_CONFIG_BACKUP_ENDPOINT=https://s3.example.ru
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID=CHANGE_ME
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY=CHANGE_ME
