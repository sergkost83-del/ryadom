# Обратный прокси с автоматическим HTTPS (сертификат Lets Encrypt выпускается сам).
# Если нужно ограничить админку по IP, добавьте перед reverse_proxy блок:
#   @admin path /ВАШ_ADMIN_URL*
#   @blocked not remote_ip 203.0.113.10
#   respond @admin @blocked 403
{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}
	request_body {
		max_size 2MB
	}
	reverse_proxy backend:8000 {
		header_up X-Forwarded-For {remote_host}
	}
}
